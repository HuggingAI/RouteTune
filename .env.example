# Put real values in .env or another ignored env file. Never commit API keys.
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Docker Compose host port.
ROUTETUNE_PORT=8787

# Optional: when set, RouteTune business APIs require this Bearer Token.
ROUTETUNE_API_KEY=

# Optional: enabled-model availability probe interval. Default 1800 (30 minutes); 0 disables it.
ROUTETUNE_MODEL_CHECK_INTERVAL_SECONDS=1800
